# Optional: the app works locally without a provider key.
# Copy this file to .env, then set your provider key and its LiteLLM model ID.
# Chat sends retrieved Python source excerpts and recent chat turns to this model.
CODEMAP_MODEL=gpt-4o-mini

# For another provider, set CODEMAP_MODEL to its supported LiteLLM model ID:
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
